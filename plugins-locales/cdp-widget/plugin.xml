<?xml version='1.0' encoding='utf-8'?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android" id="cdp-widget" version="1.0.0">
    <name>CdpWidget</name>
    <description>Widget de la pantalla principal: muestra las tareas de hoy sin abrir la app.</description>
    <license>Apache 2.0</license>
    <keywords>tareas,widget,escritorio,agenda</keywords>

    <js-module src="www/widget.js" name="Widget">
        <clobbers target="cdpWidget" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="CdpWidget">
                <param name="android-package" value="com.tareas.notif.CdpWidget" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <receiver android:name="com.tareas.notif.WidgetProvider" android:exported="false">
                <intent-filter>
                    <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                </intent-filter>
                <meta-data android:name="android.appwidget.provider" android:resource="@xml/cdp_widget_info" />
            </receiver>
        </config-file>

        <source-file src="src/android/CdpWidget.java" target-dir="src/com/tareas/notif" />
        <source-file src="src/android/WidgetProvider.java" target-dir="src/com/tareas/notif" />
        <resource-file src="src/android/cdp_widget_info.xml" target="res/xml/cdp_widget_info.xml" />
        <resource-file src="src/android/cdp_widget.xml" target="res/layout/cdp_widget.xml" />
        <resource-file src="src/android/cdp_widget_row.xml" target="res/layout/cdp_widget_row.xml" />
        <resource-file src="src/android/cdp_widget_bg.xml" target="res/drawable/cdp_widget_bg.xml" />
        <resource-file src="src/android/cdp_row_bg.xml" target="res/drawable/cdp_row_bg.xml" />
    </platform>
</plugin>
